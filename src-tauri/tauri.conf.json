{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rolebit",
  "version": "0.1.0",
  "identifier": "com.rolebit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rolebit",
        "width": 1440,
        "height": 900,
        "minWidth": 1050,
        "minHeight": 700,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "Discover and organize job opportunities locally.",
    "longDescription": "Rolebit discovers, organizes, and preserves job opportunities in a private local database.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
